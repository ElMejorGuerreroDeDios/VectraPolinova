       <!-- CONTENT FRAME -->
       <item>
        <widget class="QFrame" name="frame">
         <property name="styleSheet">
          <string notr="true">QFrame#frame { background-color: #0A0010; }

QLabel#welcome_label {
    color: #7C3AED; font: 600 9pt "Segoe UI";
    background: transparent; letter-spacing: 1px;
}
QLabel#user_label {
    color: #EDE9FE; font: 700 20pt "Segoe UI"; background: transparent;
}
QLabel#sub_label {
    color: #4C1D8A; font: 600 8pt "Segoe UI";
    background: transparent; letter-spacing: 2px;
}

QLabel#badge_easy_1, QLabel#badge_easy_2,
QLabel#badge_easy_3, QLabel#badge_easy_4 {
    border-radius: 6px; font: 700 7pt "Segoe UI";
    padding: 3px 8px; letter-spacing: 1px;
}
QLabel#badge_easy_1 { background-color: #2D0A0A; color: #F87171; }
QLabel#badge_easy_2 { background-color: #052E16; color: #4ADE80; }
QLabel#badge_easy_3 { background-color: #1C1000; color: #FACC15; }
QLabel#badge_easy_4 { background-color: #1C1000; color: #FACC15; }

QLabel#name_lbl_1, QLabel#name_lbl_2,
QLabel#name_lbl_3, QLabel#name_lbl_4 {
    color: #EDE9FE; font: 700 10pt "Segoe UI";
    background: transparent; letter-spacing: 1px;
}

QPushButton {
    border-radius: 8px; font: 700 9pt "Segoe UI";
    color: #C084FC; border: 1px solid #3D0070;
    background-color: #160028; padding: 8px 0px; letter-spacing: 2px;
}
QPushButton:hover { background-color:#5B21B6; border:1px solid #7C3AED; color:#FFFFFF; }
QPushButton:pressed { background-color:#7C3AED; border:1px solid #A855F7; color:#FFFFFF; }

QLabel#label, QLabel#label_2, QLabel#label_3, QLabel#label_4 {
    background-color: #0E0018; border-radius: 8px 8px 0px 0px;
}
</string>
